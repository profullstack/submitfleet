{
  "name": "@profullstack/submitfleet",
  "version": "0.5.0",
  "description": "SubmitFleet: launch your product on 339 launch sites and directories from one profile. Prepared submissions, accounts with passkeys, a tracked launch queue, CLI, MCP server and API.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://submitfleet.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/submitfleet.git"
  },
  "bugs": {
    "url": "https://github.com/profullstack/submitfleet/issues"
  },
  "keywords": [
    "launch",
    "directory",
    "submission",
    "mcp",
    "cli",
    "startup"
  ],
  "bin": {
    "submitfleet": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "catalog",
    "web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@libsql/client": "0.18.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@profullstack/affiliates": "0.3.0",
    "@profullstack/footer": "^0.4.0",
    "@profullstack/profile": "0.1.6",
    "@profullstack/redeem-credits": "0.2.0",
    "@profullstack/sealed-secrets": "0.1.0",
    "@profullstack/webhooks": "0.2.1",
    "@profullstack/x402-gateway": "^0.16.1",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "4.13.14",
    "mailchecker": "6.0.21",
    "undici": "^8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
