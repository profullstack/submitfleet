#!/usr/bin/env bash
# Run a command inside the w3bs-desktop container, in the desktop session environment.
exec docker exec ${DX_DETACH:+-d} -e XDG_RUNTIME_DIR=/tmp/runtime-1000 -e HOME=/home/desktop -e WAYLAND_DISPLAY=wayland-0 \
  -e DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/runtime-1000/bus w3bs-desktop "$@"
